{
  "metadata": [
    {
      "src": [
        {
          "src": "../Fluxer.Net",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "**/images/**",
          "../logo.png"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
	    "_template/material"
    ],
    "globalMetadata": {
	    "_appTitle": "Fluxer.net Documentation",
      "_appName": "Fluxer.net",
      "_enableSearch": true,
      "_appLogoPath": "../logo.png",
      "_appFaviconPath": "../logo.png"
    }
  }
}